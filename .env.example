# --- Gmail OAuth (1단계) ---
# Google Cloud 콘솔에서 데스크톱 앱 OAuth 클라이언트 JSON 경로
GMAIL_CREDENTIALS_PATH=credentials/client_secret.json
# 최초 대화형 로그인 후 자동 생성 (Refresh Token 포함 ≈ Cursor Secrets의 토큰)
GMAIL_TOKEN_PATH=token.json
# 발송/초안의 보낸 사람 표시 이름(선택). 비우면 Gmail 계정 기본 이름 사용.
# 주소는 항상 OAuth 로그인 계정과 동일(스크립트가 getProfile로 자동 설정).
# GMAIL_FROM_DISPLAY_NAME=JAMBRO

# --- 수신자 (5단계 → 8단계) ---
# 5단계: 테스트 시 본인 Gmail 주소
DIGEST_RECIPIENT=
# 8단계: 운영 수신자로 바꿀 때 이 값을 사용 (비우면 DIGEST_RECIPIENT만 사용)
# DIGEST_PRODUCTION_RECIPIENT=marius.oh@lge.com
USE_PRODUCTION_RECIPIENT=0

# --- 실행 모드 ---
# 1: Gmail에 요약 초안(드래프트)만 생성 — 즉시 발송하지 않음(문서 권장)
CREATE_GMAIL_DRAFT=1
# AUTO_SEND=1 이면 초안 대신 즉시 발송(수신자는 DIGEST_*). 테스트 후 보통 0으로 되돌림.
AUTO_SEND=0
# 1이면 파일만 쓰고 드래프트/발송 없음
DRY_RUN=0

# --- 요약 다듬기 (선택, 3단계 의미) ---
# 스크립트를 --no-llm 없이 실행하면: 먼저 규칙 기반 마크다운을 만든 뒤, 아래 키가 있으면 LLM이 문장만 정리합니다.
# 키가 없으면 자동으로 규칙 기반만 사용됩니다(오류 아님).

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Genspark — POST https://www.genspark.ai/api/tool_cli/agent_ask (X-Api-Key)
# api.genspark.ai 는 DNS에 없을 수 있음 → 기본 www 사용
# LLM_PROVIDER=genspark
# GENSPARK_API_KEY=
# GSK_API_KEY=
# GSK_KEY=
# GENSPARK_BASE_URL=https://www.genspark.ai
# GENSPARK_TASK_TYPE=super_agent
# GENSPARK_PROJECT_ID=

TZ=Asia/Seoul
